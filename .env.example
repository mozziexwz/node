# Copy to .env. Use your actual domain and independently generated secrets.
MSBOOST_DOMAIN=panel.example.com
MSBOOST_SITE_ADDRESS=panel.example.com
PUBLIC_URL=https://panel.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Defaults to the original database. Offline recovery imports into a NEW database;
# change this only after reviewing the restored data (see docs/backup-recovery.md).
MSBOOST_DATABASE_NAME=msboost
ADMIN_EMAIL=12345678@qq.com
ADMIN_PASSWORD=replace-with-at-least-16-random-characters
COOKIE_SECURE=true
# Direct binary deployments: trust only your reverse proxy's exact IP/CIDR.
# Compose sets its dedicated Caddy address. Never use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=
# Optional 32-byte hex/base64 key. If omitted, generated in data/master.key.
# Back this key up separately. Losing it makes stored secrets unrecoverable.
MASTER_KEY=
# Default deployment pulls this prebuilt image; --build is an explicit fallback.
MSBOOST_VERSION=v0.2.4
MSBOOST_IMAGE=ghcr.io/mozziexwz/node:v0.2.4
